# Lokale Entwicklung: kopieren nach apps/api/.env
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:5173
DATABASE_URL=postgres://hausanna:hausanna@localhost:5432/hausanna
MONGODB_URL=mongodb://localhost:27017/hausanna
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
UPLOAD_DIR=./data/uploads

# Erster Admin (wird beim ersten Start angelegt, wenn es noch keinen Benutzer gibt)
ADMIN_EMAIL=admin@hausanna-bodenmais.de
ADMIN_PASSWORD=bitte-aendern-123

# E-Mail: leer lassen = Mails werden nicht versendet, sondern in MongoDB "mail_outbox" gespeichert
SMTP_HOST=
MAIL_OWNER_TO=info@hausanna-bodenmais.de

# Kanal: none | beds24 | ical
CHANNEL_PROVIDER=none
BEDS24_REFRESH_TOKEN=
BEDS24_WEBHOOK_SECRET=
CHANNEL_SYNC_INTERVAL_MINUTES=5
