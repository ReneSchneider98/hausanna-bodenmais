# /etc/hausanna/api.env – Konfiguration der API (Produktion)
# Wird von install.sh einmalig erzeugt (Platzhalter __...__ werden ersetzt).
# Danach NIE wieder automatisch überschrieben. Änderungen: Datei bearbeiten,
# dann `systemctl restart hausanna-api`.

NODE_ENV=production
PORT=3000

# Datenbanken (nur lokal erreichbar)
DATABASE_URL=postgres://hausanna:__PG_PASSWORD__@127.0.0.1:5432/hausanna
MONGODB_URL=mongodb://hausanna:__MONGO_PASSWORD__@127.0.0.1:27017/hausanna?authSource=admin

# Sicherheit
JWT_SECRET=__JWT_SECRET__

# Öffentliche Adresse und erlaubte Origins
PUBLIC_BASE_URL=https://__DOMAIN__
CORS_ORIGINS=https://__DOMAIN__,https://www.__DOMAIN__

# Hochgeladene Bilder (nginx liefert sie unter /media/ aus)
UPLOAD_DIR=/var/lib/hausanna/uploads

# Erster Admin-Benutzer (wird nur angelegt, wenn noch kein Benutzer existiert)
ADMIN_EMAIL=__ADMIN_EMAIL__
ADMIN_PASSWORD=__ADMIN_PASSWORD__

# E-Mail-Versand über IONOS
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=info@__DOMAIN__
SMTP_PASSWORD=
MAIL_FROM="Haus Anna Bodenmais <info@__DOMAIN__>"
MAIL_OWNER_TO=info@__DOMAIN__

# Kanal-Anbindung (Booking.com + Airbnb über Beds24)
BEDS24_REFRESH_TOKEN=
BEDS24_WEBHOOK_SECRET=__BEDS24_WEBHOOK_SECRET__
CHANNEL_SYNC_INTERVAL_MINUTES=5
